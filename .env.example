# --- Data directory (REQUIRED) ---
# Large artifacts (chunks / vectors / SQLite) are NOT in the repo.
# Point this to the directory that holds them.
RAG_DATA_DIR=./data

# --- Credentials file (optional) ---
# Defaults to this file; point elsewhere if keys live in another .env
# RAG_ENV_FILE=/path/to/.env

# --- LLM (copy to .env and fill in; same-named env vars also work) ---
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=deepseek-chat

# --- Runtime switches ---
# RAG_OFFLINE=1 (default) -> never hit HuggingFace at runtime.
#   On a fresh machine set RAG_OFFLINE=0 for the first run, or pre-download models (see README).
RAG_OFFLINE=1
# RAG_DEVICE=cuda | cpu  (default cuda)
RAG_DEVICE=cuda
