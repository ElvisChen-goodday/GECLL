# ===== 数据目录（必填；chunks/向量/SQLite 等大文件不入库）=====
RAG_DATA_DIR=D:/RAG/data/finder

# ===== 凭证文件（可选）=====
# 默认读本文件的 OPENAI_*；若密钥放在别处，可指向那个文件
# RAG_ENV_FILE=D:/RAG/.env

# ===== LLM 与凭据（复制为 .env 后填写；也可直接用同名环境变量）=====
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=deepseek-chat
